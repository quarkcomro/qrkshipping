{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Modules.Qrkshipping.Admin' %}

{% block content %}
  {% include '@Modules/qrkshipping/views/templates/admin/_navigation.html.twig' %}
  {% include '@Modules/qrkshipping/views/templates/admin/_shop_context.html.twig' %}

  <div class="row">
    <div class="col-xl-7">
      <section class="card mb-3">
        <h2 class="card-header h3">{{ 'Diagnostic preferences'|trans }}</h2>
        <div class="card-body">
          {% if not diagnosticsPreferenceReadable %}
            <div class="alert alert-danger mb-0">
              {{ 'The diagnostic preference could not be read safely. Editing is disabled.'|trans({}, 'Modules.Qrkshipping.Errors') }}
            </div>
          {% else %}
            <p>
              {{ 'Effective source:'|trans }} <strong>{{ diagnosticsSource }}</strong>
              {% if diagnosticsInherited %}<span class="badge badge-info">{{ 'inherited'|trans }}</span>{% endif %}
            </p>
            <form method="post" action="{{ path('admin_qrkshipping_preferences_update') }}">
              <input type="hidden" name="_token" value="{{ csrfToken }}">
              <input type="hidden" name="action" value="save_diagnostics">
              <div class="form-group">
                <label for="diagnostics_detail_level">{{ 'Detail level'|trans }}</label>
                <select class="form-control" id="diagnostics_detail_level" name="diagnostics_detail_level">
                  <option value="standard" {% if diagnosticsDetailLevel == 'standard' %}selected{% endif %}>{{ 'Standard'|trans }}</option>
                  <option value="detailed" {% if diagnosticsDetailLevel == 'detailed' %}selected{% endif %}>{{ 'Detailed'|trans }}</option>
                </select>
              </div>
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" value="1" id="inherit" name="inherit">
                <label class="form-check-label" for="inherit">
                  {{ 'Remove the override at this context and use inheritance.'|trans }}
                </label>
              </div>
              <button class="btn btn-primary" type="submit">{{ 'Save diagnostic preference'|trans }}</button>
            </form>
          {% endif %}
        </div>
      </section>
    </div>

    <div class="col-xl-5">
      <section class="card mb-3">
        <h2 class="card-header h3">{{ 'Cargus provider-account shell'|trans }}</h2>
        <div class="card-body">
          {% if not providerAccountReadable %}
            <div class="alert alert-danger">{{ 'The provider-account state could not be read safely.'|trans({}, 'Modules.Qrkshipping.Errors') }}</div>
          {% elseif shopContext.type != 'shop' %}
            <div class="alert alert-warning">
              {{ 'Provider accounts are isolated per shop. Select one shop before editing.'|trans }}
            </div>
          {% else %}
            <p>{{ 'Only an internal draft label is stored in this increment. No credentials or live connection are accepted.'|trans }}</p>
            <form method="post" action="{{ path('admin_qrkshipping_preferences_update') }}">
              <input type="hidden" name="_token" value="{{ csrfToken }}">
              <input type="hidden" name="action" value="save_provider_account">
              <div class="form-group">
                <label for="provider_account_label">{{ 'Internal label'|trans }}</label>
                <input
                  class="form-control"
                  type="text"
                  id="provider_account_label"
                  name="provider_account_label"
                  value="{{ providerAccount ? providerAccount.label : 'Cargus' }}"
                  maxlength="160"
                  required
                >
              </div>
              <button class="btn btn-primary" type="submit">{{ 'Save draft label'|trans }}</button>
            </form>
            {% if providerAccount %}
              <p class="mt-3 mb-0">
                {{ 'Current status:'|trans }} <span class="badge badge-secondary">{{ providerAccount.status.value }}</span>
              </p>
            {% endif %}
          {% endif %}
        </div>
      </section>
    </div>
  </div>

  <section class="card mb-3">
    <h2 class="card-header h3">{{ 'Lifecycle and data retention'|trans }}</h2>
    <div class="card-body">
      {% if not lifecyclePolicyReadable %}
        <div class="alert alert-danger mb-0">
          {{ 'The global lifecycle policy could not be read safely. Editing is disabled.'|trans({}, 'Modules.Qrkshipping.Errors') }}
        </div>
      {% else %}
        <div class="alert alert-warning">
          <p class="mb-1"><strong>{{ 'These options control destructive module lifecycle operations.'|trans }}</strong></p>
          <p class="mb-0">{{ 'Encrypted secrets are always deleted during uninstall and reset. Enabled destructive options permanently remove additional QRK Shipping data.'|trans }}</p>
        </div>

        {% if shopContext.type != 'all' %}
          <div class="alert alert-info">
            {{ 'Lifecycle policy is global. Select the All stores context to change it.'|trans }}
          </div>
          <dl class="row mb-0">
            <dt class="col-sm-7">{{ 'Delete all QRK Shipping tables and data on uninstall'|trans }}</dt>
            <dd class="col-sm-5">
              {% if purgeOnUninstall %}
                <span class="badge badge-danger">{{ 'Enabled'|trans }}</span>
              {% else %}
                <span class="badge badge-secondary">{{ 'Disabled'|trans }}</span>
              {% endif %}
            </dd>
            <dt class="col-sm-7">{{ 'Reset all QRK Shipping data to catalog defaults on module reset'|trans }}</dt>
            <dd class="col-sm-5">
              {% if resetToDefaults %}
                <span class="badge badge-danger">{{ 'Enabled'|trans }}</span>
              {% else %}
                <span class="badge badge-secondary">{{ 'Disabled'|trans }}</span>
              {% endif %}
            </dd>
          </dl>
        {% else %}
          <form method="post" action="{{ path('admin_qrkshipping_preferences_update') }}">
            <input type="hidden" name="_token" value="{{ csrfToken }}">
            <input type="hidden" name="action" value="save_lifecycle_policy">

            <div class="form-check mb-3">
              <input
                class="form-check-input"
                type="checkbox"
                value="1"
                id="purge_on_uninstall"
                name="purge_on_uninstall"
                aria-describedby="purge_on_uninstall_help"
                {% if purgeOnUninstall %}checked{% endif %}
              >
              <label class="form-check-label" for="purge_on_uninstall">
                <strong>{{ 'Delete all QRK Shipping tables and data on uninstall'|trans }}</strong><br>
                <span class="text-muted" id="purge_on_uninstall_help">{{ 'When enabled, uninstall permanently removes every table in the QRK Shipping qrkship_ namespace, including settings, provider-account shells, audit events, and encrypted secrets.'|trans }}</span>
              </label>
            </div>

            <div class="form-check mb-3">
              <input
                class="form-check-input"
                type="checkbox"
                value="1"
                id="reset_to_defaults"
                name="reset_to_defaults"
                aria-describedby="reset_to_defaults_help"
                {% if resetToDefaults %}checked{% endif %}
              >
              <label class="form-check-label" for="reset_to_defaults">
                <strong>{{ 'Reset all QRK Shipping data to catalog defaults on module reset'|trans }}</strong><br>
                <span class="text-muted" id="reset_to_defaults_help">{{ 'When enabled, Reset permanently removes all QRK Shipping data, recreates the foundation schema, and restores catalog defaults.'|trans }}</span>
              </label>
            </div>

            <button class="btn btn-primary" type="submit">{{ 'Save lifecycle policy'|trans }}</button>
          </form>
        {% endif %}
      {% endif %}
    </div>
  </section>

  <div class="alert alert-info mb-0">
    {{ 'Inheritance order: shop override, then shop-group override, then all-stores value, then catalog default.'|trans }}
  </div>
{% endblock %}
