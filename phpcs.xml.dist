<?xml version="1.0"?>
<ruleset name="QRK Shipping PSR-12">
  <description>PSR-12 gate for QRK Shipping-owned PHP code.</description>
  <file>qrkshipping.php</file>
  <file>src</file>
  <file>tests</file>
  <file>upgrade</file>
  <file>scripts</file>
  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>
  <exclude-pattern>vendor/*</exclude-pattern>
  <rule ref="PSR12"/>
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="120"/>
      <property name="absoluteLineLimit" value="160"/>
    </properties>
  </rule>
</ruleset>
